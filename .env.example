# Copy to .env. Never commit real secrets.
# Empty values keep conservative Uzbek extraction and public RSS enabled.
AI_API_KEY=
# OPENAI_API_KEY is also supported locally; cloud uses AI_API_KEY.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Provider chain (keys remain in secure environment settings, never Git).
LLM_ENABLED=true
LLM_PROVIDER_ORDER=gemini,openrouter,groq,openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES_PER_PROVIDER=1
LLM_CIRCUIT_BREAKER_FAILURES=3
LLM_BATCH_DELAY_SECONDS=1
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
# Brave Search API key, optional. No Google HTML scraping.
SEARCH_API_KEY=
# Required to access /admin and /api/admin/*; set a long random value outside Git.
ADMIN_API_KEY=
# Required. Real connection values belong in Render/Codespace secrets only.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SCHEDULER_ENABLED=false
DATABASE_AUTO_MIGRATE=false
STARTUP_DATA_UPDATES_ENABLED=false
CORS_ORIGINS=[]
# Render supplies PORT automatically.
PORT=8000
SCHEDULER_HOUR=9
SCHEDULER_TIMEZONE=Asia/Tashkent
DAILY_PUBLISH_LIMIT=100
DAILY_UZ_LIMIT=30
# Optional. GitHub repository search works without a token at lower rate limits.
GITHUB_TOKEN=
MAX_CANDIDATES=30
FETCH_TIMEOUT=15
MAX_PAGE_BYTES=2000000
# Set an honest contact URL/email for your own deployment.
USER_AGENT=StartupFinder/0.1 (+public research aggregator; respects robots.txt)
# Only enable behind a trusted managed egress proxy that blocks private destinations.
# Allows proxy DNS for explicitly configured source hosts when local DNS is unavailable.
TRUSTED_EGRESS_PROXY=false

# Mandatory named-creator and existence gates also apply.
EVIDENCE_MIN_SCORE=5
MAX_EVENT_FOLLOWUPS=3
# SOURCES_FILE=/absolute/path/to/config/sources.json

# Bounded archive traversal and targeted fresh search.
ARCHIVE_PAGES=20
SEARCH_QUERIES_PER_SOURCE=3

# Problem-first intelligence uses the same database, source registry and scheduler.
# No new API secret is required. The monthly cross-country scan uses a public
# Show HN RSS signal source; broader international problem adapters remain pending.

# External GitHub Actions job, not the sleeping Render scheduler.
DAILY_PROJECT_TARGET=20
DAILY_MAX_RUN_SECONDS=2700
DAILY_PAGES_PER_RUN=60
DAILY_PAGES_PER_DAY=80
DAILY_GEMINI_REQUESTS_PER_RUN=10
DAILY_GEMINI_REQUESTS_PER_DAY=10
DAILY_GROQ_REQUESTS_PER_RUN=10
DAILY_GROQ_REQUESTS_PER_DAY=10
DAILY_SEARCH_REQUESTS_PER_RUN=0
DAILY_SEARCH_REQUESTS_PER_DAY=0
DAILY_GITHUB_REQUESTS_PER_RUN=2
DAILY_GITHUB_REQUESTS_PER_DAY=2
DAILY_CANDIDATES_PER_RUN=80
DAILY_CANDIDATES_PER_DAY=120
DAILY_MAX_SOURCES=12
DAILY_LLM_MIN_INTERVAL_SECONDS=60
DAILY_LLM_MAX_OUTPUT_TOKENS=2048
DAILY_MAX_DATABASE_BYTES=250000000
DAILY_MAX_RSS_MB=384
# Enable ONLY after confirming account/model is free, without paid auto-overage.
FREE_PROVIDER_QUOTAS_CONFIRMED=false
# Strict workflow never injects Brave credentials and keeps its budget zero.
FREE_SEARCH_QUOTA_CONFIRMED=false
BACKUP_MAX_BYTES=20971520
BACKUP_MAX_SECONDS=180
# GitHub backup workflow needs this secret; do not put a real value here.
BACKUP_ENCRYPTION_PASSPHRASE=
