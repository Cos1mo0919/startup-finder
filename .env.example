# Copy to .env. Never commit real secrets.
# Empty values keep conservative Uzbek extraction and public RSS enabled.
AI_API_KEY=
# OPENAI_API_KEY is also supported locally; cloud uses AI_API_KEY.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Provider chain (keys remain in secure environment settings, never Git).
LLM_ENABLED=true
LLM_PROVIDER_ORDER=gemini,openrouter,groq,openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES_PER_PROVIDER=1
LLM_CIRCUIT_BREAKER_FAILURES=3
LLM_BATCH_DELAY_SECONDS=1
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
# Brave Search API key, optional. No Google HTML scraping.
SEARCH_API_KEY=
# Required to access /admin and /api/admin/*; set a long random value outside Git.
ADMIN_API_KEY=
# Default database lives in ./data/finder.sqlite3 (absolute path resolved by app).
# DATABASE_URL=sqlite:////absolute/path/to/data/finder.sqlite3
# PostgreSQL: postgresql+psycopg://user:password@host/database
SCHEDULER_ENABLED=true
MAX_CANDIDATES=30
FETCH_TIMEOUT=15
MAX_PAGE_BYTES=2000000
# Set an honest contact URL/email for your own deployment.
USER_AGENT=StartupFinder/0.1 (+public research aggregator; respects robots.txt)
# Only enable behind a trusted managed egress proxy that blocks private destinations.
# Allows proxy DNS for explicitly configured source hosts when local DNS is unavailable.
TRUSTED_EGRESS_PROXY=false

# Mandatory named-creator and existence gates also apply.
EVIDENCE_MIN_SCORE=5
MAX_EVENT_FOLLOWUPS=3
# SOURCES_FILE=/absolute/path/to/config/sources.json

# Bounded archive traversal and targeted fresh search.
ARCHIVE_PAGES=20
SEARCH_QUERIES_PER_SOURCE=3

# Problem-first intelligence uses the same database, source registry and scheduler.
# No new API secret is required. The monthly cross-country scan uses a public
# Show HN RSS signal source; broader international problem adapters remain pending.
